generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  registers CashRegister[]

  @@index([name])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  width       String?  // z.B. "57mm", "80mm"
  length      String?  // z.B. "15m", "18m", "25m", "50m", "80m"
  price       Float    @default(0)
  stock       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sales       Sale[]

  @@index([name])
}

model Sale {
  id             String   @id @default(cuid())
  productName    String
  productDetails String?
  price          Float
  quantity       Int      @default(1)
  totalAmount    Float
  saleDate       DateTime @default(now())
  taxType        String?  // B=Brutto, N=Netto, N-B, B-N
  paymentMethod  String?  // SEPA, Bar, etc.
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([customerId])
  @@index([saleDate])
  @@index([productId])
}

// Kassensystem eines Kunden inkl. TSE-Zertifikat und Finanzamt-Meldung (ELSTER)
model CashRegister {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label         String?   // Standort / Bezeichnung, z.B. "Theke 1"
  model         String    // z.B. "SAM4S SPS-2000"
  serialNumber  String?
  tseSerial     String?
  tseExpiry     DateTime? // Ablaufdatum des TSE-Zertifikats
  installDate   DateTime?
  elsterStatus  String    @default("OFFEN") // OFFEN, GEMELDET, ABGEMELDET
  elsterDate    DateTime?
  notes         String?
  reminderStage Int?      // zuletzt per E-Mail gemeldete Stufe (Tage): 90, 60, 30, 14, 7, 0
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
  @@index([tseExpiry])
}
